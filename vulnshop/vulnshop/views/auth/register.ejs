<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <a href="/" class="auth-logo">VulnShop</a>
    <h1 class="auth-title">Create account</h1>

    <% if (error) { %>
      <div class="alert alert-danger">⚠️ <%= error %></div>
    <% } %>

    <!-- VULNERABILITY: role field not present in HTML but can be injected via Burp/curl -->
    <!-- Mass Assignment: POST with role=admin grants admin privileges -->
    <form action="/auth/register" method="POST" class="auth-form">

      <div class="form-group">
        <label>Your name</label>
        <input type="text" name="full_name" class="form-input" placeholder="First and last name">
      </div>

      <div class="form-group">
        <label>Username <span class="required">*</span></label>
        <input type="text" name="username" class="form-input" placeholder="Choose a username" required>
      </div>

      <div class="form-group">
        <label>Email address <span class="required">*</span></label>
        <input type="email" name="email" class="form-input" placeholder="Enter your email" required>
      </div>

      <div class="form-group">
        <label>Phone number</label>
        <input type="tel" name="phone" class="form-input" placeholder="Mobile phone number">
      </div>

      <div class="form-group">
        <label>Password <span class="required">*</span></label>
        <input type="password" name="password" class="form-input" placeholder="At least 4 characters" required>
        <small class="form-hint">Passwords must be at least 4 characters.</small>
      </div>

      <div class="form-group">
        <label>Address</label>
        <textarea name="address" class="form-input" rows="2" placeholder="Your shipping address"></textarea>
      </div>

      <!-- NOTE: role field intentionally omitted from UI but accepted by server -->
      <!-- To exploit: add name="role" value="admin" via DevTools or Burp -->

      <button type="submit" class="btn-full btn-amazon">Continue</button>

      <p class="auth-terms">
        By creating an account, you agree to VulnShop's <a href="#">Conditions of Use</a> and <a href="#">Privacy Notice</a>.
      </p>
    </form>

    <div class="auth-divider"><span>Already have an account?</span></div>
    <a href="/auth/login" class="btn-full btn-secondary">Sign In</a>
  </div>

  <div class="auth-hint-card">
    <h3>💡 Challenge Hint</h3>
    <p><strong>Mass Assignment:</strong> This registration form accepts a hidden <code>role</code> field.</p>
    <p>Try adding <code>role=admin</code> to the POST body using:</p>
    <ul>
      <li>Browser DevTools (add a hidden input)</li>
      <li>Burp Suite (intercept & modify)</li>
      <li>curl: <code>curl -X POST /auth/register -d "username=hacker&email=h@h.com&password=test&role=admin"</code></li>
    </ul>
  </div>
</div>

<%- include('../partials/footer') %>
