# ─────────────────────────────────────────────────────────
# VulnShop — Environment Configuration
# Copy this file to .env and fill in your MySQL password
# ─────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Set this to YOUR MySQL password (blank if none)
DB_PASSWORD=
DB_NAME=vulnshop

# ── Session ───────────────────────────────────────────────
SESSION_SECRET=vulnshop-super-secret-key-2024
