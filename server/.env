PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bugbounty_simulator
DB_USER=root
DB_PASS=

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production_32chars
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production_32chars
JWT_EXPIRES_IN=7d

# Flag HMAC Secret
FLAG_SECRET=your_flag_hmac_secret_32chars_minimum

# Nmap binary path (Windows: C:\Program Files (x86)\Nmap\nmap.exe)
NMAP_PATH=nmap

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
